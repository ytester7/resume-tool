{
  "name": "resume-tool",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "lint": "eslint src/ e2e/",
    "lint:fix": "eslint src/ e2e/ --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"e2e/**/*.ts\"",
    "thumbs": "node scripts/generate-thumbs.mjs"
  },
  "dependencies": {
    "@vueuse/core": "^10.7.0",
    "docx": "^9.12.0",
    "html2pdf.js": "^0.10.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.40.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.1.0"
  }
}
